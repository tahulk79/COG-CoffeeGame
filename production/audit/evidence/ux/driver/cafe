#!/bin/zsh
S=/private/tmp/claude-501/-Users-macos--claude-spares-spare-NWSOv6/adc7003a-e9c8-4fdd-a6bd-c12d80f84fd8/scratchpad; E=/Users/macos/Desktop/V2/production/audit/evidence/ux
L=$1; O=$E/vp-$L.txt
T() { echo "## $1" >> $O; $S/c eval "$(cat $S/targets.js)" >> $O; }
M() { $S/c eval 'JSON.stringify({ev:__ev.filter(e=>["click","pointerup","pointerdown"].includes(e.n)).map(e=>e.n+":"+e.d+"ms(delay "+e.delay+",proc "+e.proc+")"),lt:__lt.map(l=>l.d)})' | sed "s/^/  timing $1: /" >> $O; }
R() { $S/c eval '__ev.length=0;__lt.length=0;1' >/dev/null; }
$S/tb "Để sau" >> $O; sleep 1; R; $S/tb "Vào quán" >> $O
for i in {1..20}; do sleep 1; [[ $($S/c eval 'document.title') == *Quán* ]] && break; done; sleep 2; M enter-cafe
$S/c shot $E/$L-7-cafe.jpg >/dev/null; T cafe
$S/tb "Mở cửa" >> $O; sleep 1.5
for k in 1 2 3 4 5 6; do
XY=$($S/c eval '(()=>{const p=__proj(-7,1,-10.6);const on=p[0]>20&&p[0]<innerWidth-20&&p[1]>200&&p[1]<innerHeight-150;const cx=innerWidth/2,cy=innerHeight/2;let dx=p[0]-cx,dy=p[1]-cy;const k=Math.min(1,Math.min(innerWidth*.3/Math.abs(dx||1),innerHeight*.25/Math.abs(dy||1)));return (on?"ON ":"OFF ")+Math.round(on?p[0]:cx+dx*k)+" "+Math.round(on?p[1]:cy+dy*k)})()' | tr -d '"'); echo "bar screen try $k: $XY" >> $O
R; $S/tap ${=XY#* }; [[ $XY == ON* ]] && { sleep 0.3; M bar-tap; sleep 8; break; }; sleep 3; done
$S/c eval '"bench open: "+!!document.querySelector("dialog[open]")' >> $O
$S/c shot $E/$L-8-bench.jpg >/dev/null; T bench
$S/c eval '[...document.querySelectorAll("dialog[open]")].forEach(d=>d.close());1' >/dev/null; sleep .5
$S/tb "Nông trại" >> $O; for i in {1..20}; do sleep 1; [[ $($S/c eval 'document.title') == *Nông* ]] && break; done
echo cafe-done
